# ---- Family Frame settings: copy to .env and edit ----
TZ=Europe/London
# 4-8 digit PIN needed to change lists from the phone (leave empty to disable)
FAMILY_PIN=2468
# Long random text used to sign the PIN cookie. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Weather (Open-Meteo, no key needed)
PLACE_NAME=London
LATITUDE=51.5072
LONGITUDE=-0.1276
UK_REGION=england-and-wales

# Everything below can also be set later in the admin page: http://<server>:8080/admin
# (admin page values override this file).

# Immich: use the LAN address, then EITHER an API key OR email + password.
IMMICH_URL=http://192.168.1.50:2283
IMMICH_API_KEY=
IMMICH_EMAIL=
IMMICH_PASSWORD=
# Optional: only show these people / albums (comma separated IDs from Immich URLs)
IMMICH_PERSON_IDS=
IMMICH_ALBUM_IDS=

# iCloud shared calendars: Person|link, comma separated.
# iPhone: Calendar -> Calendars -> (i) -> Public Calendar -> Share Link
ICAL_URLS=Family|webcal://p00-caldav.icloud.com/published/2/XXXX,Mum|webcal://...

# Google Photos album name for the optional gphotos-sync helper
GOOGLE_ALBUM=Family Frame
